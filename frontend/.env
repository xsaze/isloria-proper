# Development Environment Variables (Local Testing)
VITE_API_URL=http://localhost:3001

# Presale Subdomain (for subdomain detection)
VITE_PRESALE_SUBDOMAIN=island.localhost

# BSC Network (Backup)
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org

# Token Contract (Update when deployed)
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Presale Contract (Optional - if using smart contract)
VITE_PRESALE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Project ID (Optional - get from https://cloud.walletconnect.com/)
# Leave as YOUR_PROJECT_ID for now - MetaMask will still work
VITE_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID

# ========================================
# SOLANA CONFIGURATION (PRIMARY)
# ========================================

# Solana Network (mainnet-beta | devnet | testnet)
VITE_SOLANA_NETWORK=mainnet-beta

# Helius RPC URL (Premium RPC with better reliability and speed)
# Replace YOUR_HELIUS_API_KEY with your actual API key from https://dashboard.helius.dev
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=9fcd700d-91ca-434e-9a69-1e967bb76934

# Presale Payment Wallet (receives SOL payments)
# TEST WALLET - for initial testing only
VITE_PRESALE_WALLET_ADDRESS=2AGnpightTepD5Wn7u4Zx2EUgkFrbydNaeNWNPCxG8dt

# Your SPL Token Mint Address
VITE_TOKEN_MINT_ADDRESS=GasvKRubiw4Zum57uTWDeadMxQKNpHfJACqevmhrdBW2

# Token Reward per Island (200000 tokens per island purchase)
VITE_TOKENS_PER_ISLAND=200000
