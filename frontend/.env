# Development Environment Variables (Local Testing)
VITE_API_URL=http://localhost:3001

# Presale Subdomain (for subdomain detection)
VITE_PRESALE_SUBDOMAIN=island.localhost

# BSC Network
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org

# Token Contract (Update when deployed)
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Presale Contract (Optional - if using smart contract)
VITE_PRESALE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Project ID (Optional - get from https://cloud.walletconnect.com/)
# Leave as YOUR_PROJECT_ID for now - MetaMask will still work
VITE_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID
