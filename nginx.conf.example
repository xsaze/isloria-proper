# Nginx Configuration for Isloria Presale
# Place this in: /etc/nginx/sites-available/isloria
# Then symlink: sudo ln -s /etc/nginx/sites-available/isloria /etc/nginx/sites-enabled/

# Main game site - binaria.fun
server {
    listen 80;
    listen [::]:80;
    server_name binaria.fun www.binaria.fun;

    # Redirect HTTP to HTTPS (after SSL setup)
    # return 301 https://$server_name$request_uri;

    root /var/www/isloria-proper/frontend/dist;
    index index.html;

    # Serve static files (game)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy WebSocket connections to backend
    location /socket.io/ {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Proxy API requests to backend
    location /api/ {
        proxy_pass http://localhost:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Presale subdomain - island.binaria.fun
server {
    listen 80;
    listen [::]:80;
    server_name island.binaria.fun;

    # Redirect HTTP to HTTPS (after SSL setup)
    # return 301 https://$server_name$request_uri;

    # IMPORTANT: Same dist folder as main site!
    # The React app detects subdomain and shows presale page
    root /var/www/isloria-proper/frontend/dist;
    index index.html;

    # Serve static files (presale)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy presale API requests to backend
    location /api/presale/ {
        proxy_pass http://localhost:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

